{
  "name": "@trymellon/js",
  "version": "3.1.0",
  "description": "SDK oficial de TryMellon para integrar autenticación passwordless con Passkeys / WebAuthn",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "./dist/ui/index.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs",
      "default": "./dist/react.js"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "import": "./dist/vue.js",
      "require": "./dist/vue.cjs",
      "default": "./dist/vue.js"
    },
    "./angular": {
      "types": "./dist/angular.d.ts",
      "import": "./dist/angular.js",
      "require": "./dist/angular.cjs",
      "default": "./dist/angular.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "import": "./dist/ui/index.js",
      "default": "./dist/ui/index.js"
    },
    "./umd": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.global.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\" && tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:angular": "npm run build && vitest run --config vitest.angular.config.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:workflows": "node scripts/run-actionlint.cjs .github/workflows",
    "format": "prettier --write \"**/*.{ts,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json,md}\"",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm run typecheck && npm run lint",
    "prepare": "npm run build",
    "sri": "node scripts/sri.js",
    "audit:ci": "audit-ci --config audit-ci.jsonc",
    "test:e2e": "playwright test",
    "semantic-release": "semantic-release"
  },
  "keywords": [
    "webauthn",
    "passkeys",
    "passwordless",
    "authentication",
    "sdk",
    "trymellon"
  ],
  "author": "TryMellon",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ResakaGit/trymellon-js.git"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "overrides": {
    "flatted": ">=3.4.2",
    "picomatch": ">=4.0.4",
    "minimatch": ">=3.1.4",
    "test-exclude": {
      "minimatch": "^3.1.4"
    },
    "serve-handler": {
      "minimatch": "^3.1.4"
    }
  },
  "browserslist": [
    ">0.5%",
    "last 2 versions",
    "not dead",
    "iOS >= 14"
  ],
  "devDependencies": {
    "@angular/core": "^19.2.18",
    "@angular/platform-browser-dynamic": "^19.2.18",
    "@playwright/test": "^1.49.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.11.0",
    "@types/react": "^19.2.13",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/coverage-v8": "^1.2.0",
    "@vue/test-utils": "^2.4.6",
    "audit-ci": "^7.1.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "happy-dom": "^20.8.9",
    "jsdom": "^24.0.0",
    "prettier": "^3.2.5",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "semantic-release": "^24.2.9",
    "serve": "^14.2.4",
    "tsup": "^8.0.0",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.53.0",
    "vitest": "^1.2.0",
    "vue": "^3.5.28"
  },
  "peerDependencies": {
    "@angular/core": "^17.0.0 || ^18.0.0 || ^19.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "vue": "^3.3.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "@angular/core": {
      "optional": true
    }
  }
}
